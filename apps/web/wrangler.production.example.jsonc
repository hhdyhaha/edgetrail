{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "your-edgetrail-web",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BETTER_AUTH_URL": "https://your-edgetrail-web.example.com",
    "COLLECTOR_ORIGIN": "https://your-edgetrail-collector.example.com"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_API_TOKEN",
      "WAE_DATASET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-edgetrail-production",
      "database_id": "replace-with-production-d1-database-id"
    }
  ]
}

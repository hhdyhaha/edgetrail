{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "your-edgetrail-collector-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["HASH_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-edgetrail-dev",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "your-web-analytics-events"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENT_QUEUE",
        "queue": "your-edgetrail-events"
      }
    ]
  },
  "env": {
    "production": {
      "name": "your-edgetrail-collector",
      "secrets": {
        "required": ["HASH_SECRET"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "your-edgetrail-production",
          "database_id": "replace-with-production-d1-database-id"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "your-web-analytics-events"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENT_QUEUE",
            "queue": "your-edgetrail-events"
          }
        ]
      }
    }
  }
}

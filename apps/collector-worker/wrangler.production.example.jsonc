{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "your-edgetrail-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["HASH_SECRET"]
  },
  "vars": {
    "DASHBOARD_ORIGIN": "https://your-edgetrail-web.example.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE_ROOMS",
        "class_name": "PresenceRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_presence_rooms",
      "new_sqlite_classes": ["PresenceRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-edgetrail-production",
      "database_id": "replace-with-production-d1-database-id"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "your_web_analytics_events"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENT_QUEUE",
        "queue": "your-edgetrail-events"
      }
    ]
  }
}

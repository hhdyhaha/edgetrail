{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "your-edgetrail-queue",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "queues": {
    "consumers": [
      {
        "queue": "your-edgetrail-events",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "your-edgetrail-events-dlq"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-edgetrail-production",
      "database_id": "replace-with-production-d1-database-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVE_BUCKET",
      "bucket_name": "your-edgetrail-archive-production"
    }
  ],
  "upload_source_maps": true
}
